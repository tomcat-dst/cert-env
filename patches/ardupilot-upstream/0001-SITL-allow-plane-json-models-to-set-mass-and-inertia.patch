From 31032c55aab17800ef2c9f2b1a4d79dde857a3ca Mon Sep 17 00:00:00 2001
From: Vlad Syan <vlad.syan@gmail.com>
Date: Sun, 22 Nov 2026 15:12:17 +0200
Subject: [PATCH 1/2] SITL: allow plane json models to set mass and inertia

The plane model has a fixed 2 kg mass and applies aerodynamic torque
directly as angular acceleration, so a json model of a heavier or
larger aircraft has to distort its wing geometry to get realistic
forces per kilogram.

Add two optional json keys:
  mass     kg, replaces the built-in mass (thrust_scale follows it)
  inertia  [Ixx, Iyy, Izz] kg m^2, divides the body torques

Models that do not set them behave exactly as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libraries/SITL/SIM_Plane.cpp | 12 ++++++++++++
 libraries/SITL/SIM_Plane.h   |  3 +++
 2 files changed, 15 insertions(+)

diff --git a/libraries/SITL/SIM_Plane.cpp b/libraries/SITL/SIM_Plane.cpp
index 0357158b7a..355d651121 100644
--- a/libraries/SITL/SIM_Plane.cpp
+++ b/libraries/SITL/SIM_Plane.cpp
@@ -119,6 +119,11 @@ Plane::Plane(const char *frame_str) :
         mass = 2.0;
         coefficient.c_drag_p = 0.05;
     }
+
+    if (is_positive(coefficient.mass)) {
+        mass = coefficient.mass;
+        thrust_scale = (mass * GRAVITY_MSS) / hover_throttle;
+    }
 }
 
 void Plane::load_coeffs(const char *model_json)
@@ -193,6 +198,8 @@ void Plane::load_coeffs(const char *model_json)
         COFF_FLOAT(deltae_max),
         COFF_FLOAT(deltar_max),
         { "CGOffset", &coefficient.CGOffset, VarType::VECTOR3F },
+        COFF_FLOAT(mass),
+        { "inertia", &coefficient.inertia, VarType::VECTOR3F },
     };
 
     for (uint8_t i=0; i<ARRAY_SIZE(vars); i++) {
@@ -473,6 +480,11 @@ void Plane::calculate_forces(const struct sitl_input &input, Vector3f &rot_accel
     
     Vector3f force = getForce(aileron, elevator, rudder);
     rot_accel = getTorque(aileron, elevator, rudder, thrust, force);
+    if (coefficient.inertia.x > 0 && coefficient.inertia.y > 0 && coefficient.inertia.z > 0) {
+        rot_accel.x /= coefficient.inertia.x;
+        rot_accel.y /= coefficient.inertia.y;
+        rot_accel.z /= coefficient.inertia.z;
+    }
 
     if (have_launcher) {
         /*
diff --git a/libraries/SITL/SIM_Plane.h b/libraries/SITL/SIM_Plane.h
index a9f71f5b63..5e5904b795 100644
--- a/libraries/SITL/SIM_Plane.h
+++ b/libraries/SITL/SIM_Plane.h
@@ -90,6 +90,9 @@ protected:
         // the X CoG offset should be -0.02, but that makes the plane too tail heavy
         // in manual flight. Adjusted to -0.15 gives reasonable flight
         Vector3f CGOffset{-0.15, 0, -0.05};
+        // optional overrides from a json model; zero keeps the built-in behaviour
+        float mass = 0;                 // kg
+        Vector3f inertia{0, 0, 0};      // kg m^2 about body x, y, z
     } default_coefficients;
 
     struct Coefficients coefficient;
