     }
 
+    if (&new_mode == &mode_auto) {
+        // RFSEARCH stays set when code returns to the mode flown before (fence, soaring), but a switch
+        // into AUTO to land (RTL autoland, failsafe to DO_LAND_START) is plain AUTO
+        switch (reason) {
